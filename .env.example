# MedFlow — copy to .env. Never commit real secrets.
APP_ENV=development
JWT_SECRET=change-me-in-any-non-local-environment
JWT_EXPIRE_MINUTES=480

DATABASE_URL=postgresql+asyncpg://medflow:medflow@postgres:5432/medflow
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

MODEL_REGISTRY_PATH=/app/models/registry.yaml
MAX_WORKERS=16
MODEL_TIMEOUT_MS=200
RATE_LIMIT_PER_MINUTE=120

ALLOWED_CLOCK_SKEW_SECONDS=300
ALLOWED_LATENESS_SECONDS=120
IDEMPOTENCY_TTL_SECONDS=86400
ALERT_DEDUP_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
